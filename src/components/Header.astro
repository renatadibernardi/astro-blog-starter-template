---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

const navItems = [
	{ href: '/', label: 'Início' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/link', label: 'Recursos' },
	{ href: '/about', label: 'Sobre' },
];
---

<header>
	<nav>
		<a class="logo" href="/">
			<span class="logo-mark" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<div class="nav-links">
			{navItems.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</div>
		<a class="cta" href="https://instagram.com/identidadeemdeus" target="_blank" rel="noopener noreferrer">
			Instagram
		</a>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 40;
		padding: 0 clamp(1rem, 4vw, 2rem);
		background: rgba(255, 253, 250, 0.9);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid rgba(var(--gray-light), 0.9);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		min-height: 66px;
		max-width: 1180px;
		margin: 0 auto;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--portal-font-display, Georgia, serif);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
	}
	.logo-mark {
		width: 9px;
		height: 9px;
		flex-shrink: 0;
		border-radius: 2px;
		background: var(--accent-dark);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.nav-links::-webkit-scrollbar {
		display: none;
	}
	.nav-links a {
		display: flex;
		align-items: center;
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		font-family: var(--portal-font-sans, "Inter", sans-serif);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--gray-dark));
		white-space: nowrap;
		transition: background-color 0.18s ease, color 0.18s ease;
	}
	.nav-links a:hover {
		background: var(--portal-accent-soft, rgba(118, 90, 166, 0.12));
		color: var(--accent-dark);
	}
	nav a.active {
		text-decoration: none;
	}
	.nav-links a.active {
		background: var(--accent);
		color: #fff;
		font-weight: 700;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 1.1rem;
		border: 1px solid rgb(var(--black));
		border-radius: 999px;
		font-family: var(--portal-font-mono, ui-monospace, monospace);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 0.18s ease, color 0.18s ease;
	}
	.cta:hover {
		background: rgb(var(--black));
		color: var(--portal-bg, #fbf8f3);
	}
	@media (max-width: 640px) {
		.cta {
			display: none;
		}
		nav {
			min-height: 58px;
		}
		.logo {
			font-size: 1rem;
		}
	}
</style>
