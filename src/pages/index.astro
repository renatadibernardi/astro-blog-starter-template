---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const studyThemes = [
	{
		title: 'As 12 Tribos de Israel',
		heading: 'Um tema, muitas perguntas para investigar.',
		description:
			'Quem eram os filhos de Jacó? Como surgiram as tribos e que papel cada uma ocupa na narrativa bíblica? Aqui quero reunir a origem, a história, as bênçãos, os territórios e as principais referências de cada tribo.',
	},
	{
		title: 'Judá e o Leão',
		description:
			'Por que o leão se tornou associado à tribo de Judá? Este estudo passa pelas palavras de Jacó, pela linhagem de Judá, pelo rei Davi e pelas referências que aparecem posteriormente nas Escrituras.',
	},
	{
		title: 'Céus e constelações',
		description:
			'Estrelas e constelações aparecem em diferentes passagens bíblicas. A proposta aqui é observar esses textos, compreender o seu contexto e distinguir astronomia, linguagem simbólica e interpretações que surgiram depois.',
	},
	{
		title: 'Tribos, meses e símbolos',
		description:
			'Existem tradições que relacionam as tribos de Israel aos meses hebraicos e a diferentes símbolos. Aqui quero investigar de onde essas associações surgiram, o que pertence à tradição e o que realmente encontramos no texto bíblico.',
	},
	{
		title: 'Calendário hebraico',
		description:
			'Como funcionam os meses do calendário hebraico? Quais festas aparecem na Bíblia e o que elas representam? Este espaço reúne estudos sobre meses, festas, ciclos e o contexto histórico de Israel.',
	},
];

const faqs = [
	{
		question: 'Este é um site de astrologia?',
		answer: [
			'Não. Alguns estudos podem passar por constelações, zodíaco, calendários ou antigas associações simbólicas, mas o objetivo é investigar a origem dessas ideias e compreender a relação — ou ausência de relação — delas com o texto bíblico.',
		],
	},
	{
		question: 'Vais estudar as 12 Tribos de Israel?',
		answer: [
			'Sim. As 12 Tribos são um dos temas que quero explorar com mais profundidade, começando pela narrativa bíblica e avançando para história, símbolos e tradições relacionadas.',
		],
	},
	{
		question: 'E as associações entre tribos, meses e signos?',
		answer: [
			'Também podem aparecer como objeto de estudo. Quando isso acontecer, quero deixar claro o que está na Bíblia, o que vem da tradição e o que pertence a interpretações posteriores.',
		],
	},
	{
		question: 'Todos os textos representam uma conclusão definitiva?',
		answer: [
			'Não. Sou estudante de Teologia e este espaço acompanha o meu processo de aprendizagem. Alguns textos podem registrar uma conclusão; outros podem terminar com novas perguntas.',
		],
	},
	{
		question: 'Por que estudar esses temas?',
		answer: [
			'Porque aprender também significa fazer perguntas, voltar às fontes e reconhecer quando ainda existe algo para compreender melhor.',
		],
	},
	{
		question: 'O que significa separar texto, tradição e interpretação?',
		answer: [
			'Significa não apresentar como texto bíblico uma associação que nasceu posteriormente. Sempre que possível, quero identificar a origem de cada ideia e o contexto em que ela aparece.',
		],
	},
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Fé, raízes hebraicas e as perguntas que valem a pena investigar.</h1>

			<section class="site-service-band" aria-labelledby="types-title">
				<div class="site-types-info">
					<p class="eyebrow">Temas para explorar</p>
					<h2 id="types-title">{studyThemes[0].heading}</h2>
					<p class="site-types-intro">
						Cada assunto pode começar pequeno e crescer conforme avanço nos
						estudos. Clique em cada tema para explorar as perguntas e anotações
						relacionadas.
					</p>
					<div
						class="site-types-detail"
						id="site-types-detail"
						role="region"
						aria-live="polite"
					>
						<h3 id="site-types-detail-title">{studyThemes[0].title}</h3>
						<p id="site-types-detail-text">{studyThemes[0].description}</p>
					</div>
				</div>
				<ul class="site-types-list" role="tablist" aria-label="Temas de estudo">
					{
						studyThemes.map((theme, index) => (
							<li>
								<button
									type="button"
									class="site-type-option"
									role="tab"
									aria-selected={index === 0 ? 'true' : 'false'}
									aria-controls="site-types-detail"
									data-title={theme.title}
									data-description={theme.description}
								>
									{theme.title}
								</button>
							</li>
						))
					}
				</ul>
			</section>

			<section class="site-faq-section" aria-labelledby="site-faq-title">
				<div class="site-faq-heading">
					<p class="eyebrow">Perguntas frequentes</p>
					<h2 id="site-faq-title">
						Algumas coisas importantes antes de continuar
					</h2>
					<p>
						Este é um espaço de estudo e aprendizado. Alguns assuntos possuem
						diferentes interpretações e quero deixar essas diferenças visíveis ao
						longo do caminho.
					</p>
				</div>

				<div class="site-faq-list">
					{
						faqs.map((faq, index) => (
							<details open={index === 0}>
								<summary>{faq.question}</summary>
								<div class="site-faq-answer">
									{faq.answer.map((paragraph) => (
										<p>{paragraph}</p>
									))}
								</div>
							</details>
						))
					}
				</div>
			</section>

			<section class="site-service-cta" aria-labelledby="site-cta-title">
				<p class="eyebrow">Continuar estudando</p>
				<h2 id="site-cta-title">Qual pergunta vamos investigar agora?</h2>
				<p>
					Este espaço vai crescer conforme os meus estudos avançarem. Bíblia,
					Israel, tribos, símbolos, céus e aquelas perguntas que fazem abrir mais
					um livro e continuar pesquisando.
				</p>
				<a class="button primary" href="/blog">
					Explorar os estudos
				</a>
			</section>
		</main>
		<Footer />

		<script>
			const options =
				document.querySelectorAll<HTMLButtonElement>('.site-type-option');
			const titleEl = document.getElementById('site-types-detail-title');
			const textEl = document.getElementById('site-types-detail-text');

			options.forEach((option) => {
				option.addEventListener('click', () => {
					options.forEach((other) =>
						other.setAttribute('aria-selected', 'false'),
					);
					option.setAttribute('aria-selected', 'true');

					if (titleEl) titleEl.textContent = option.dataset.title ?? '';
					if (textEl) textEl.textContent = option.dataset.description ?? '';
				});
			});
		</script>

		<style>
			main {
				width: 100vw;
				max-width: none;
				box-sizing: border-box;
				position: relative;
				left: 50%;
				transform: translateX(-50%);
				padding-left: max(24px, calc((100vw - 1120px) / 2));
				padding-right: max(24px, calc((100vw - 1120px) / 2));
			}
			main > h1 {
				max-width: 760px;
			}
			.site-service-band {
				position: relative;
				left: 50%;
				width: 100vw;
				box-sizing: border-box;
				transform: translateX(-50%);
				display: grid;
				grid-template-columns: minmax(0, 0.9fr) minmax(260px, 0.58fr);
				align-items: center;
				gap: clamp(28px, 6vw, 72px);
				padding: clamp(44px, 7vw, 72px) max(24px, calc((100vw - 1120px) / 2));
				border-top: 1px solid rgb(var(--gray-light));
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.site-service-band .eyebrow {
				margin: 0;
				color: var(--accent-dark);
				font-family: var(--portal-font-sans, "Inter", sans-serif);
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.site-service-band h2 {
				max-width: 620px;
				margin: 12px 0 0;
			}
			.site-types-intro {
				max-width: 660px;
				margin: 16px 0 0;
				color: rgb(var(--gray));
			}
			.site-types-detail {
				margin-top: clamp(20px, 3vw, 28px);
				padding: clamp(18px, 3vw, 24px);
				background: var(--portal-surface, #fffdfa);
				border: 1px solid rgb(var(--gray-light));
				border-left: 3px solid var(--accent);
				border-radius: 8px;
				box-shadow: 0 12px 30px rgba(61, 47, 71, 0.06);
			}
			.site-types-detail h3 {
				margin: 0;
				font-size: 1.3rem;
			}
			.site-types-detail p {
				margin: 10px 0 0;
				color: rgb(var(--gray));
			}
			.site-types-list {
				display: grid;
				gap: 10px;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.site-types-list li {
				margin: 0;
			}
			.site-type-option {
				display: block;
				width: 100%;
				padding: 12px 14px;
				color: rgb(var(--black));
				background: var(--portal-surface, #fffdfa);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				font: inherit;
				font-family: var(--portal-font-sans, "Inter", sans-serif);
				font-weight: 600;
				text-align: left;
				cursor: pointer;
				transition:
					border-color 0.22s ease,
					box-shadow 0.22s ease,
					transform 0.22s ease,
					background 0.22s ease;
			}
			.site-type-option:hover,
			.site-type-option:focus-visible {
				border-color: color-mix(in srgb, var(--accent) 38%, transparent);
				box-shadow: 0 12px 30px rgba(61, 47, 71, 0.1);
				transform: translateX(6px);
				outline: none;
			}
			.site-type-option[aria-selected='true'] {
				border-color: color-mix(in srgb, var(--accent) 60%, transparent);
				background: var(--portal-accent-soft, rgba(118, 90, 166, 0.12));
				box-shadow: 0 12px 30px rgba(61, 47, 71, 0.12);
				transform: translateX(6px);
			}
			@media (prefers-reduced-motion: reduce) {
				.site-type-option:hover,
				.site-type-option:focus-visible,
				.site-type-option[aria-selected='true'] {
					transform: none;
				}
			}
			@media (max-width: 860px) {
				.site-service-band {
					grid-template-columns: minmax(0, 1fr);
				}
			}

			.site-faq-section {
				position: relative;
				left: 50%;
				width: 100vw;
				box-sizing: border-box;
				transform: translateX(-50%);
				display: grid;
				grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
				align-items: start;
				gap: clamp(28px, 6vw, 72px);
				padding: clamp(44px, 7vw, 72px) max(24px, calc((100vw - 1120px) / 2));
				border-top: 1px solid rgb(var(--gray-light));
			}
			.site-faq-heading {
				position: sticky;
				top: 88px;
			}
			.site-faq-heading .eyebrow {
				margin: 0;
				color: var(--accent-dark);
				font-family: var(--portal-font-sans, "Inter", sans-serif);
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.site-faq-heading h2 {
				max-width: 520px;
				margin-top: 12px;
			}
			.site-faq-heading p:not(.eyebrow) {
				max-width: 500px;
				margin: 18px 0 0;
				color: rgb(var(--gray));
			}
			.site-faq-list {
				overflow: hidden;
				background:
					radial-gradient(circle at 92% 8%, rgba(118, 90, 166, 0.1), transparent 28%),
					var(--portal-surface, #fffdfa);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				box-shadow: 0 18px 54px rgba(61, 47, 71, 0.08);
			}
			.site-faq-list details {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.site-faq-list details:last-child {
				border-bottom: 0;
			}
			.site-faq-list summary {
				position: relative;
				display: grid;
				grid-template-columns: 24px minmax(0, 1fr);
				gap: 14px;
				align-items: center;
				min-height: 62px;
				padding: 17px 22px;
				color: rgb(var(--black));
				cursor: pointer;
				font-family: var(--portal-font-sans, "Inter", sans-serif);
				font-weight: 700;
				list-style: none;
			}
			.site-faq-list summary::-webkit-details-marker {
				display: none;
			}
			.site-faq-list summary::before {
				display: grid;
				width: 24px;
				height: 24px;
				place-items: center;
				color: var(--accent-dark);
				content: '+';
				background: var(--portal-bg-subtle, #f5efe8);
				border: 1px solid rgba(118, 90, 166, 0.18);
				border-radius: 50%;
				font-family: var(--portal-font-sans, "Inter", sans-serif);
				font-size: 1rem;
				line-height: 1;
			}
			.site-faq-list details[open] summary {
				color: var(--accent-dark);
				background: rgba(245, 239, 232, 0.58);
			}
			.site-faq-list details[open] summary::before {
				color: #fff;
				content: '-';
				background: var(--accent-dark);
				border-color: var(--accent-dark);
			}
			.site-faq-answer {
				padding: 0 22px 22px 60px;
				color: rgb(var(--gray));
			}
			.site-faq-answer p {
				margin: 0;
			}
			.site-faq-answer p + p {
				margin-top: 12px;
			}
			.site-faq-answer ul {
				display: grid;
				gap: 8px;
				margin: 16px 0 0;
				padding: 0;
				list-style: none;
			}
			.site-faq-answer li {
				position: relative;
				padding-left: 18px;
			}
			.site-faq-answer li::before {
				position: absolute;
				top: 0.72em;
				left: 0;
				width: 7px;
				height: 7px;
				content: '';
				background: var(--portal-rose, #b87964);
				border-radius: 50%;
				transform: translateY(-50%);
			}
			@media (max-width: 860px) {
				.site-faq-section {
					grid-template-columns: minmax(0, 1fr);
				}
				.site-faq-heading {
					position: static;
				}
			}
			@media (max-width: 560px) {
				.site-faq-list summary {
					min-height: 58px;
					padding: 15px 16px;
				}
				.site-faq-answer {
					padding: 0 16px 18px 54px;
				}
			}

			.site-service-cta {
				position: relative;
				left: 50%;
				width: min(1120px, calc(100vw - 48px));
				box-sizing: border-box;
				transform: translateX(-50%);
				margin: clamp(14px, 3vw, 28px) 0 clamp(30px, 5vw, 48px);
				padding: clamp(44px, 7vw, 72px) clamp(34px, 6vw, 58px);
				color: #fff;
				background:
					linear-gradient(120deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px) 0 0 / 34px 34px,
					linear-gradient(135deg, #3c3443 0%, #54456b 48%, #8a655f 100%);
				border-radius: 8px;
			}
			.site-service-cta .eyebrow {
				margin: 0;
				color: #fff;
				font-family: var(--portal-font-sans, "Inter", sans-serif);
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.site-service-cta h2 {
				color: #fff;
			}
			.site-service-cta p:not(.eyebrow) {
				max-width: 690px;
				margin: 16px 0 24px;
				color: rgba(255, 255, 255, 0.84);
			}
			.site-service-cta .button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 40px;
				padding: 10px 17px;
				border: 1px solid transparent;
				border-radius: 8px;
				font-family: var(--portal-font-sans, "Inter", sans-serif);
				font-weight: 700;
				text-decoration: none;
				transition:
					transform 0.2s ease,
					background 0.2s ease,
					box-shadow 0.2s ease;
			}
			.site-service-cta .button:hover,
			.site-service-cta .button:focus-visible {
				transform: translateY(-2px);
				box-shadow: 0 12px 26px rgba(61, 47, 71, 0.24);
			}
			.site-service-cta .button.primary {
				color: var(--accent-dark);
				background: #fff;
			}
		</style>
	</body>
</html>
