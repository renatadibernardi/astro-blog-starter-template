---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const studyThemes = [
	{
		title: 'As 12 Tribos de Israel',
		heading: 'Um tema, muitas perguntas para investigar.',
		description:
			'Quem eram os filhos de Jacó? Como surgiram as tribos e que papel cada uma ocupa na narrativa bíblica? Aqui quero reunir a origem, a história, as bênçãos, os territórios e as principais referências de cada tribo.',
	},
	{
		title: 'Judá e o Leão',
		description:
			'Por que o leão se tornou associado à tribo de Judá? Este estudo passa pelas palavras de Jacó, pela linhagem de Judá, pelo rei Davi e pelas referências que aparecem posteriormente nas Escrituras.',
	},
	{
		title: 'Céus e constelações',
		description:
			'Estrelas e constelações aparecem em diferentes passagens bíblicas. A proposta aqui é observar esses textos, compreender o seu contexto e distinguir astronomia, linguagem simbólica e interpretações que surgiram depois.',
	},
	{
		title: 'Tribos, meses e símbolos',
		description:
			'Existem tradições que relacionam as tribos de Israel aos meses hebraicos e a diferentes símbolos. Aqui quero investigar de onde essas associações surgiram, o que pertence à tradição e o que realmente encontramos no texto bíblico.',
	},
	{
		title: 'Calendário hebraico',
		description:
			'Como funcionam os meses do calendário hebraico? Quais festas aparecem na Bíblia e o que elas representam? Este espaço reúne estudos sobre meses, festas, ciclos e o contexto histórico de Israel.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧑‍🚀 Hello, Astronaut!</h1>
			<p>
				Welcome to the official <a href="https://astro.build/">Astro</a> blog starter template. This
				template serves as a lightweight, minimally-styled starting point for anyone looking to build
				a personal website, blog, or portfolio with Astro.
			</p>
			<p>
				This template comes with a few integrations already configured in your
				<code>astro.config.mjs</code> file. You can customize your setup with
				<a href="https://astro.build/integrations">Astro Integrations</a> to add tools like Tailwind,
				React, or Vue to your project.
			</p>
			<p>Here are a few ideas on how to get started with the template:</p>
			<ul>
				<li>Edit this page in <code>src/pages/index.astro</code></li>
				<li>Edit the site header items in <code>src/components/Header.astro</code></li>
				<li>Add your name to the footer in <code>src/components/Footer.astro</code></li>
				<li>Check out the included blog posts in <code>src/content/blog/</code></li>
				<li>Customize the blog post page layout in <code>src/layouts/BlogPost.astro</code></li>
			</ul>
			<p>
				Have fun! If you get stuck, remember to <a href="https://docs.astro.build/"
					>read the docs
				</a> or <a href="https://astro.build/chat">join us on Discord</a> to ask questions.
			</p>
			<p>
				Looking for a blog template with a bit more personality? Check out <a
					href="https://github.com/Charca/astro-blog-template"
					>astro-blog-template
				</a> by <a href="https://twitter.com/Charca">Maxi Ferreira</a>.
			</p>

			<section class="site-service-band" aria-labelledby="types-title">
				<div class="site-types-info">
					<p class="eyebrow">Temas para explorar</p>
					<h2 id="types-title">{studyThemes[0].heading}</h2>
					<p class="site-types-intro">
						Cada assunto pode começar pequeno e crescer conforme avanço nos
						estudos. Clique em cada tema para explorar as perguntas e anotações
						relacionadas.
					</p>
					<div
						class="site-types-detail"
						id="site-types-detail"
						role="region"
						aria-live="polite"
					>
						<h3 id="site-types-detail-title">{studyThemes[0].title}</h3>
						<p id="site-types-detail-text">{studyThemes[0].description}</p>
					</div>
				</div>
				<ul class="site-types-list" role="tablist" aria-label="Temas de estudo">
					{
						studyThemes.map((theme, index) => (
							<li>
								<button
									type="button"
									class="site-type-option"
									role="tab"
									aria-selected={index === 0 ? 'true' : 'false'}
									aria-controls="site-types-detail"
									data-title={theme.title}
									data-description={theme.description}
								>
									{theme.title}
								</button>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />

		<script>
			const options =
				document.querySelectorAll<HTMLButtonElement>('.site-type-option');
			const titleEl = document.getElementById('site-types-detail-title');
			const textEl = document.getElementById('site-types-detail-text');

			options.forEach((option) => {
				option.addEventListener('click', () => {
					options.forEach((other) =>
						other.setAttribute('aria-selected', 'false'),
					);
					option.setAttribute('aria-selected', 'true');

					if (titleEl) titleEl.textContent = option.dataset.title ?? '';
					if (textEl) textEl.textContent = option.dataset.description ?? '';
				});
			});
		</script>

		<style>
			.site-service-band {
				position: relative;
				left: 50%;
				width: 100vw;
				box-sizing: border-box;
				transform: translateX(-50%);
				display: grid;
				grid-template-columns: minmax(0, 0.9fr) minmax(260px, 0.58fr);
				align-items: center;
				gap: clamp(28px, 6vw, 72px);
				padding: clamp(42px, 6vw, 68px) max(24px, calc((100vw - 1120px) / 2));
				border-top: 1px solid rgb(var(--gray-light));
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.site-service-band .eyebrow {
				margin: 0;
				color: var(--accent-dark);
				font-family: var(--portal-font-sans, "Inter", sans-serif);
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.site-service-band h2 {
				max-width: 620px;
				margin: 12px 0 0;
			}
			.site-types-intro {
				max-width: 660px;
				margin: 16px 0 0;
				color: rgb(var(--gray));
			}
			.site-types-detail {
				margin-top: clamp(20px, 3vw, 28px);
				padding: clamp(18px, 3vw, 24px);
				background: var(--portal-surface, #fffdfa);
				border: 1px solid rgb(var(--gray-light));
				border-left: 3px solid var(--accent);
				border-radius: 8px;
				box-shadow: 0 12px 30px rgba(61, 47, 71, 0.06);
			}
			.site-types-detail h3 {
				margin: 0;
				font-size: 1.3rem;
			}
			.site-types-detail p {
				margin: 10px 0 0;
				color: rgb(var(--gray));
			}
			.site-types-list {
				display: grid;
				gap: 10px;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.site-types-list li {
				margin: 0;
			}
			.site-type-option {
				display: block;
				width: 100%;
				padding: 12px 14px;
				color: rgb(var(--black));
				background: var(--portal-surface, #fffdfa);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				font: inherit;
				font-family: var(--portal-font-sans, "Inter", sans-serif);
				font-weight: 600;
				text-align: left;
				cursor: pointer;
				transition:
					border-color 0.22s ease,
					box-shadow 0.22s ease,
					transform 0.22s ease,
					background 0.22s ease;
			}
			.site-type-option:hover,
			.site-type-option:focus-visible {
				border-color: color-mix(in srgb, var(--accent) 38%, transparent);
				box-shadow: 0 12px 30px rgba(61, 47, 71, 0.1);
				transform: translateX(6px);
				outline: none;
			}
			.site-type-option[aria-selected='true'] {
				border-color: color-mix(in srgb, var(--accent) 60%, transparent);
				background: var(--portal-accent-soft, rgba(118, 90, 166, 0.12));
				box-shadow: 0 12px 30px rgba(61, 47, 71, 0.12);
				transform: translateX(6px);
			}
			@media (prefers-reduced-motion: reduce) {
				.site-type-option:hover,
				.site-type-option:focus-visible,
				.site-type-option[aria-selected='true'] {
					transform: none;
				}
			}
			@media (max-width: 860px) {
				.site-service-band {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
