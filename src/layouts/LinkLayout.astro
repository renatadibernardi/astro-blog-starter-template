---
import '../styles/link-global.css';
import '../styles/hermes-theme.css';

interface Props {
  title?: string;
}

const { title = 'Links Di Bernardi' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="light-linux">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Repositório de Links Di Bernardi" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/theme/tokens.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        localStorage.setItem('theme', 'light-linux');
        document.documentElement.className = 'light-linux';
      })();
    </script>
  </head>
  <body class="min-h-screen font-mondwest">
    <slot />
  </body>
</html>
